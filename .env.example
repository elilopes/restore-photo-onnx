# Copie para .env e ajuste. Todas as variáveis têm valor padrão.

# Porta do site no seu computador (http://localhost:8080)
WEB_PORT=8080

# Limites de envio e armazenamento
MAX_UPLOAD_MB=25
RETENTION_HOURS=24

# Processamento (CPU por padrão; para GPU NVIDIA ver README)
ORT_PROVIDERS=CPUExecutionProvider
MAX_CONCURRENCY=1
QUEUE_CONCURRENCY=1
